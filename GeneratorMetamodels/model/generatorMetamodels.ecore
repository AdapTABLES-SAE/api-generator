<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="generatorMetamodels" nsURI="http://www.example.org/generatorMetamodels"
    nsPrefix="generatorMetamodels">
  <eClassifiers xsi:type="ecore:EClass" name="MultipleChoice" eSuperTypes="#//ResponseModality">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="nbChoices" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ResultValidityDetermination" abstract="true"
      eSuperTypes="#//SubObjective">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="newAttribute" eType="#//SubObjectiveType"
        changeable="false" defaultValueLiteral="RES_VALIDITY" unsettable="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="SetOfFacts" eSuperTypes="#//AbstractFact">
    <eStructuralFeatures xsi:type="ecore:EReference" name="facts" lowerBound="1" upperBound="-1"
        eType="#//AbstractFact" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ProblemResolution" abstract="true" eSuperTypes="#//SubObjective">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="newAttribute" eType="#//SubObjectiveType"
        changeable="false" defaultValueLiteral="PB_RESOLUTION" unsettable="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ExitRoom" eSuperTypes="#//Room">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="type" eType="#//RoomType"
        changeable="false" volatile="true" defaultValueLiteral="EXIT" unsettable="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="QFTwoCompletion" abstract="true" eSuperTypes="#//SubObjective">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="newAttribute" eType="#//SubObjectiveType"
        changeable="false" defaultValueLiteral="COMPLETION2" unsettable="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="CurrentProgression">
    <eStructuralFeatures xsi:type="ecore:EReference" name="learningobjective" lowerBound="1"
        eType="#//LearningObjective"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="level" lowerBound="1" eType="#//Level"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Dungeon">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="mode" eType="#//GameMode"
        defaultValueLiteral="NONE"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="rooms" upperBound="-1"
        eType="#//Room" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="entry" lowerBound="1" eType="#//EntryRoom"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="numberOfRooms" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="gamingobjective" lowerBound="1"
        eType="#//GamingObjective"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Settings" abstract="true"/>
  <eClassifiers xsi:type="ecore:EClass" name="Input" eSuperTypes="#//ResponseModality"/>
  <eClassifiers xsi:type="ecore:EClass" name="QuestionRoom" abstract="true" eSuperTypes="#//Room"/>
  <eClassifiers xsi:type="ecore:EClass" name="LearningPath">
    <eStructuralFeatures xsi:type="ecore:EReference" name="learningobjectives" upperBound="-1"
        eType="#//LearningObjective" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="knowledge" eType="#//Knowledge"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="AbstractFact" abstract="true"/>
  <eClassifiers xsi:type="ecore:EClass" name="Fact" eSuperTypes="#//AbstractFact">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="description" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="LearnerPlayer">
    <eStructuralFeatures xsi:type="ecore:EReference" name="learningprofile" lowerBound="1"
        eType="#//LearningProfile" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="gameprofile" lowerBound="1"
        eType="#//GameProfile" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="firstname" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="lastname" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="HighLevelActivity">
    <eOperations name="addRoomPercentage">
      <eParameters name="entry" eType="#//RoomTypeToEIntMap"/>
    </eOperations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="level" lowerBound="1" eType="#//Level"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="numberOfQuestions" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        defaultValueLiteral="10"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="gamingobjective" lowerBound="1"
        eType="#//GamingObjective"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="selectedMode" eType="#//GameMode"
        defaultValueLiteral="NONE"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="roomTypesByPercentage"
        upperBound="-1" eType="#//RoomTypeToEIntMap" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="EntryRoom" eSuperTypes="#//Room">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="type" eType="#//RoomType"
        changeable="false" volatile="true" defaultValueLiteral="ENTRY" unsettable="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Door"/>
  <eClassifiers xsi:type="ecore:EClass" name="QFReconstruction" abstract="true" eSuperTypes="#//SubObjective">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="newAttribute" eType="#//SubObjectiveType"
        changeable="false" defaultValueLiteral="RECONSTRUCTION" unsettable="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="SubObjective" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="percentageOfApparition"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="percentageOfValidFacts"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="nbConsecutiveSuccess" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="responsemodality" lowerBound="1"
        eType="#//ResponseModality" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="settings" upperBound="-1"
        eType="#//Settings" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ResponseModality" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="responseTime" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="QFOneCompletion" abstract="true" eSuperTypes="#//SubObjective">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="newAttribute" eType="#//SubObjectiveType"
        changeable="false" defaultValueLiteral="COMPLETION1" unsettable="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="GameProfile"/>
  <eClassifiers xsi:type="ecore:EClass" name="LearningProfile">
    <eStructuralFeatures xsi:type="ecore:EReference" name="learningpath" lowerBound="1"
        eType="#//LearningPath"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="currentprogressions" upperBound="-1"
        eType="#//CurrentProgression" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="LearningObjective">
    <eStructuralFeatures xsi:type="ecore:EReference" name="levels" upperBound="-1"
        eType="#//Level" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="setoffacts" upperBound="-1"
        eType="#//SetOfFacts"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="ID" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="prerequisites" upperBound="-1"
        eType="#//Prerequisite" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="GameMode">
    <eLiterals name="LINEAR" literal="LINEAR"/>
    <eLiterals name="LABIRINTHINE" value="1"/>
    <eLiterals name="RAMDOM" value="2"/>
    <eLiterals name="NONE" value="3"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Level" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="ID" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        iD="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="settings" upperBound="-1"
        eType="#//Settings" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="subobjectives" upperBound="-1"
        eType="#//SubObjective" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Knowledge">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="knowledgefacts" upperBound="-1"
        eType="#//AbstractFact" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="QFValidityDetermination" abstract="true"
      eSuperTypes="#//SubObjective">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="newAttribute" eType="#//SubObjectiveType"
        changeable="false" defaultValueLiteral="QF_VALIDITY" unsettable="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Room" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EReference" name="concreteelements" upperBound="-1"
        eType="#//ConcreteElement"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="GamingObjective">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="RoomType">
    <eLiterals name="ENTRY"/>
    <eLiterals name="EXIT" value="1"/>
    <eLiterals name="DOOR" value="2"/>
    <eLiterals name="CHEST" value="3"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="GameDomain">
    <eStructuralFeatures xsi:type="ecore:EReference" name="gamingobjectives" lowerBound="1"
        upperBound="-1" eType="#//GamingObjective" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="gameelements" upperBound="-1"
        eType="#//GameElements" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="GameElements" abstract="true">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="type" eType="#//GameElementType"
        defaultValueLiteral="OTHER"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ConceptualElement" eSuperTypes="#//GameElements">
    <eStructuralFeatures xsi:type="ecore:EReference" name="representations" lowerBound="1"
        upperBound="-1" eType="#//ConcreteElement"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="adaptable" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ConcreteElement" eSuperTypes="#//GameElements">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="imgPath" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="GameElementType">
    <eLiterals name="CONTENT"/>
    <eLiterals name="RULE" value="1"/>
    <eLiterals name="AESTHETIC" value="2"/>
    <eLiterals name="OTHER" value="3"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="RoomTypeToEIntMap" instanceClassName="java.util.Map$Entry">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="key" eType="#//RoomType"
        defaultValueLiteral="ENTRY"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="value" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="LearningPaths">
    <eStructuralFeatures xsi:type="ecore:EReference" name="learningpaths" upperBound="-1"
        eType="#//LearningPath" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="TableBuild">
    <eLiterals name="TABLE_OPERAND"/>
    <eLiterals name="OPERAND_TABLE" value="1"/>
    <eLiterals name="MIX" value="2"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="ResultPosition">
    <eLiterals name="LEFT"/>
    <eLiterals name="RIGHT" value="1"/>
    <eLiterals name="MIX" value="2"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="TargetElement">
    <eLiterals name="RESULT"/>
    <eLiterals name="TABLE" value="1"/>
    <eLiterals name="OPERAND" value="2"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="SubObjectiveType">
    <eLiterals name="COMPLETION1"/>
    <eLiterals name="COMPLETION2" value="1"/>
    <eLiterals name="RECONSTRUCTION" value="2"/>
    <eLiterals name="QF_VALIDITY" value="3"/>
    <eLiterals name="RES_VALIDITY" value="4"/>
    <eLiterals name="PB_RESOLUTION" value="5"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Doors3Room" eSuperTypes="#//QuestionRoom"/>
  <eClassifiers xsi:type="ecore:EClass" name="Chests3Room" eSuperTypes="#//QuestionRoom"/>
  <eClassifiers xsi:type="ecore:EClass" name="AdaptedLearningGameActivity">
    <eStructuralFeatures xsi:type="ecore:EReference" name="dungeon" lowerBound="1"
        eType="#//Dungeon" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="MTQFOneCompletion" eSuperTypes="#//QFOneCompletion">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="targets" upperBound="-1"
        eType="#//TargetElement"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="MTLevel" eSuperTypes="#//Level">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="buildTableSetup" eType="#//TableBuild"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="resultPositionSetup" eType="#//ResultPosition"
        defaultValueLiteral="RIGHT"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="minInterval" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        defaultValueLiteral="1"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="maxInterval" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        defaultValueLiteral="10"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="DimensionsEntanglement">
    <eStructuralFeatures xsi:type="ecore:EReference" name="semanticrelations" upperBound="-1"
        eType="#//SemanticRelation" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="SemanticRelation" abstract="true"/>
  <eClassifiers xsi:type="ecore:EClass" name="Room2SubObjectiveCompliance" eSuperTypes="#//SemanticRelation">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="roomType" eType="#//RoomType"
        defaultValueLiteral="DOOR"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="subObjType" eType="#//SubObjectiveType"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Prerequisite">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="successPercentage" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="prerequisite" lowerBound="1"
        eType="#//Level"/>
  </eClassifiers>
</ecore:EPackage>
