<?xml version="1.0" encoding="UTF-8"?>
<generator:Gameplays
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:generator="http://www.example.org/generator"
    xsi:schemaLocation="http://www.example.org/generator ../model/generator.ecore">
  <gameplays
      name="Statue GP ">
    <quantifiedElements
        max="-1">
      <ability
          href="Abilities.xmi#ROTABLE"/>
    </quantifiedElements>
    <quantifiedElements>
      <ability
          href="Abilities.xmi#VERIFICATOR"/>
    </quantifiedElements>
  </gameplays>
  <gameplays
      name="Chest">
    <quantifiedElements
        min="2"
        max="-1">
      <ability
          href="Abilities.xmi#OPENABLE"/>
    </quantifiedElements>
  </gameplays>
</generator:Gameplays>
