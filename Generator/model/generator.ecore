  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ClassicRoom" eSuperTypes="#//Room"/>
  <eClassifiers xsi:type="ecore:EClass" name="QuestionRoom" eSuperTypes="#//Room"/>
