pre {
  "Running ETL".println();
  var cpt = 1;
}

rule Dungeon2Dungeon
    transform dIn: IN!Dungeon
    to dOut: OUT!Dungeon {
        "Dungeon created".println();
        dOut.entryRoom = "Room[" + dIn.entry.x + "/" + dIn.entry.y + "]";

        // ROOMS
        var rooms: new OUT!Rooms;
        dOut.rooms = rooms;
        dOut.rooms.room ::= dIn.rooms;
}

rule Room2Room
    transform roomIn: IN!Room
    to roomOut: OUT!Room {
        "\tRoom created".println();
        roomOut.x = roomIn.x;
        roomOut.y = roomIn.y;
        roomOut.id = "Room[" + roomIn.x + "/" + roomIn.y + "]";
        roomOut.roomTypeName = roomIn.roomtype.name;

        if (roomIn.roomtype.isTypeOf(SmallRoomType)) {
            "\tsmall".println();
            roomOut.size = OUT!RoomType#SMALL;
        } else {
            "\tlarge".println();
            roomOut.size = OUT!RoomType#LARGE;
        }
        
        if(not roomIn.questionedFacts.isEmpty()){
        	"On est ici".println();
        	var facts: new OUT!Facts;
        	
        	for (fact in roomIn.questionedFacts) { 
        	var factOUT: new OUT!Fact;
				factOUT.id = fact.questionablefact.id;
			    "On cree les faits".println();
			    factOUT.complete = fact.completeFact;
			    if(fact.correctnessToReach.isDefined()){
			    	factOUT.correctnessToReach = fact.correctnessToReach+"";
			    }
			    facts.fact.add(factOUT);         	
        	}
	
        	
			roomOut.facts = facts;
			//roomOut.facts.facts ::= roomIn.questionedFacts;	        
        }
        
        if(roomIn.statements.isDefined()){
        	for(statement in roomIn.statements){
        		var statementOut: new OUT!Statement;
        		statementOut.id = statement.id+"";
        		if(statement.type.equals(StatementType#TEXTUAL_INTERACTIVE)){
        			statementOut.type = "InteractiveStatement";
        		} else {
        			statementOut.type = "Statement";
        		}
        		statementOut.displayValue = statement.display.value;
        		statementOut.fact = statement.questionedFact.questionablefact.id+"";
        		statementOut.pos = statement.position.ID;
        		roomOut.statement.add(statementOut);
        	}
        }
        
        
        if(not roomIn.positionedElement.isEmpty()){
	        var allelements: new OUT!Elements;       
	        roomOut.elements = allelements;
	        roomOut.elements.element ::= roomIn.positionedElement;
        }
       
		
        // ROOM ACCESSES
        var accesses: new OUT!RoomAccesses;
        roomOut.roomaccesses = accesses;
        roomOut.roomaccesses.roomaccess ::= roomIn.roomaccess;
}

rule Facts2Facts 
	transform factIn : IN!QuestionedFact
	to factOut : OUT!Fact {
		factOUT.id = fact.questionablefact.id;
		
		if(not fact.completeFact.isEmpty()){
			factOUT.complete = fact.completeFact;
		}
	    if(fact.isTypeOf(MTQeFCompletion1)){
	    	factOUT.correctnessToReach = 1;
	    }
	    if(fact.isTypeOf(MTQeFCompletion2)){
	    	factOUT.correctnessToReach = 2;
	    }
	    if(fact.isTypeOf(MTQeFRebuild)){
	    	factOUT.correctnessToReach = 3;
	    }	       	
}

rule Elements2Elements 
	transform element : IN!PositionedElement
	to elementOut : OUT!Element {
	elementOut.id = element.id;
	elementOut.type = element.element.type;
	if(element.display.isDefined()){
		elementOut.displayValue = element.display.value;
	}
	if(element.correctness.isDefined()){
		elementOut.correctness = element.correctness.value.toString();
	}
	if(element.wantedAnswer.isDefined()){
		elementOut.correctAnswer = element.wantedAnswer.value;
	}
	elementOut.ability = element.element.ability.name+"";
	elementOut.pos = element.position.id;	
}

rule RoomAccess2RoomAccess
    transform access: IN!RoomAccess
    to accessOut: OUT!RoomAccess {
        "\t\tRoomAccess created".println();
        accessOut.direction = "" + access.direction;
        accessOut.id = "a" + cpt++;
        accessOut.accessRef = access.otherroomaccess.equivalent().id;
}


post{
    "done".println();
}