pre {
  "Running ETL".println();
  var cpt = 1;
}

rule Dungeon2Dungeon
    transform dIn: IN!Dungeon
    to dOut: OUT!Dungeon {
        "Dungeon created".println();
        dOut.entryRoom = "Room[" + dIn.entry.x + "/" + dIn.entry.y + "]";
		// dOut.exitRoom = "Room["+ dIn.exit.x + "/" + dIn.exit.y + "]";
		dOut.objectiveID = dIn.learningobjective.id;
		dOut.levelID = dIn.level.id;
		dOut.gameLevelID = dIn.learnerPlayer.progression.playerProgress.currentLevel;
		
		
		if(dIn.curses.isDefined()) {
			dIn.curses.println();
			dOut.curses = "["; 
			for (curse in dIn.curses) {
				curse.name.println();
				dOut.curses = dOut.curses + "\"" + curse.name + "\"" + ",";
				dOut.curses.println();
			} 
			dOut.curses = dOut.curses + "]";
		}
		
        // ROOMS
        var rooms: new OUT!Rooms;
        dOut.rooms = rooms;
        dOut.rooms.room ::= dIn.rooms;
}

rule Room2Room
    transform roomIn: IN!Room
    to roomOut: OUT!Room {
        "\tRoom created".println();
        roomOut.x = roomIn.x;
        roomOut.y = roomIn.y;
        roomOut.id = "Room[" + roomIn.x + "/" + roomIn.y + "]";
        roomOut.roomTypeName = roomIn.roomtype.name;
        
        if(roomIn.task.isDefined()){
        	roomOut.idTask = roomIn.task.id;
        	roomOut.time = roomIn.task.maxTime;
        }
              
        if (roomIn.roomtype.isTypeOf(SmallRoomType)) {
            //"\tsmall".println();
            roomOut.size = OUT!RoomType#SMALL;
        } else {
            //"\tlarge".println();
            roomOut.size = OUT!RoomType#LARGE;
        }
        
        if(not roomIn.questionedFacts.isEmpty()){
        	
        	var facts: new OUT!Facts;
        	
        	for (fact in roomIn.questionedFacts) { 
        	var factOUT: new OUT!Fact;
				factOUT.id = fact.questionablefact.id; 
				if(fact.question.instanceOf(QuestionParam)){
					factOUT.complete = fact.question.completeFact;
				}
			    if(fact.correctnessToReach.isDefined()){
			    	factOUT.correctnessToReach = fact.correctnessToReach.value.value;
			    }
			    
			    if(fact.factCorrectness.isDefined()){
			    	factOUT.correctness = fact.factCorrectness.value.value+"";
			    }
			    facts.fact.add(factOUT);         	
        	}
	        	
			roomOut.facts = facts;
			"\t\t\tFacts created".println();
			//roomOut.facts.facts ::= roomIn.questionedFacts;	        
        }
        
        if(roomIn.gameplay.isDefined()){
        	if(roomIn.gameplay.prompt.isDefined()){
				roomOut.prompt = roomIn.gameplay.prompt.prompt;
            }
        	roomOut.gameplayWithUndo = roomIn.gameplay.undoable;
        }
        
        
        if(not roomIn.positionedElement.isEmpty()){
	        var allelements: new OUT!Elements;       
	        roomOut.elements = allelements;
	        roomOut.elements.element ::= roomIn.positionedElement;
        }
       
		
        // ROOM ACCESSES
        var accesses: new OUT!RoomAccesses;
        roomOut.roomaccesses = accesses;
        roomOut.roomaccesses.roomaccess ::= roomIn.roomaccess;
}

rule Structures2Elements 
	transform element : IN!PositionedStructureElement
	to elementOut : OUT!Element {
	//"\t\t\tStrucutres creation".println();
	
	elementOut.id = element.id;		
	elementOut.pos = element.position.id;	
	elementOut.type = element.elementType.type;
	
	if(element.acceptedFacts.isDefined()){
		for (soluce in element.acceptedFacts) { 
			elementOut.acceptedFacts += soluce.value.value + ";";
		}		
	}
}

rule MapStructures2Elements 
	transform element : IN!PositionedVisualizationElement
	to elementOut : OUT!Element {
	//"\t\t\tStrucutres creation".println();
	
	elementOut.id = element.id;		
	elementOut.pos = element.position.id;	
	elementOut.type = element.elementType.type;
	
	if(element.visualization.isDefined()){
		elementOut.visualisation = element.visualization.id;
	}
}

rule Elements2Elements 
	transform element : IN!PositionedElement
	to elementOut : OUT!Element {
	//"\t\t\tElements creation".println();
		
	elementOut.id = element.id;
	
	elementOut.type = element.elementType.type;
	if(element.displays.isDefined()){
		if(element.displays.size() == 1){
			elementOut.displayValue = element.displays.get(0).value.value + "";
			elementOut.interactive = element.displays.get(0).interactive;
			elementOut.isImageDisplay = element.displays.get(0).imageDisplay; 
		}
		if(element.displays.size() > 1){
			for (display in element.displays) { 
				elementOut.interactive = display.interactive;
				if(display.correctness.value.value == ECorrectness#CORRECT){
					elementOut.displayValue = elementOut.displayValue + "[" + display.value.value + "];";
				} else {
					elementOut.displayValue = elementOut.displayValue + display.value.value + ";";
				}
			}
			elementOut.isImageDisplay = element.displays.get(0).imageDisplay; 
		}		
	} 
	
	if(element.correctness.isDefined()){
		elementOut.correctness = element.correctness.value.value.getName();
	}

	if(element.expectedAnswer.isDefined()){
		for (answer in element.expectedAnswer) {
			elementOut.correctAnswer = answer.value.value + ";";
		}
		
	}

	if(element.elementType.ability.isDefined() and not(element.elementType.ability.name == "DISPLAY")){
		elementOut.ability = element.elementType.ability.name+"";
	}

	elementOut.pos = element.position.id;	

	if(element.fact.isDefined()){
		elementOut.idFact = element.fact.questionablefact.id;
	}

	if(element.acceptedFacts.isDefined()){
		for (soluce in element.acceptedFacts) { 
			elementOut.acceptedFacts += soluce.value.value + ";";
		}		
	}
}



rule RoomAccess2RoomAccess
    transform access: IN!RoomAccess
    to accessOut: OUT!RoomAccess {
        "\t\tRoomAccess created".println();
        accessOut.direction = "" + access.direction;
        accessOut.id = "a" + cpt++;
        accessOut.accessRef = access.otherroomaccess.equivalent().id;
}


post{
    "done".println();
}