<?xml version="1.0" encoding="UTF-8"?>
<genmodel:GenModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" xmlns:genmodel="http://www.eclipse.org/emf/2002/GenModel"
    modelDirectory="/Demo/src-gen" creationIcons="false" editDirectory="/Demo.edit/src-gen"
    editorDirectory="/Demo.editor/src-gen" modelPluginID="Demo" modelName="Demo" rootExtendsClass="org.eclipse.emf.ecore.impl.MinimalEObjectImpl$Container"
    codeFormatting="true" importerID="org.eclipse.emf.importer.ecore" complianceLevel="5.0"
    copyrightFields="false" operationReflection="true" importOrganizing="true">
  <foreignModel>demo.ecore</foreignModel>
  <testsDirectory xsi:nil="true"/>
  <genPackages prefix="Demo" disposableProviderFactory="true" ecorePackage="demo.ecore#/">
    <genClasses ecoreClass="demo.ecore#//LearningPath">
      <genFeatures property="None" children="true" createChild="true" ecoreFeature="ecore:EReference demo.ecore#//LearningPath/learningobjective"/>
      <genFeatures createChild="false" ecoreFeature="ecore:EAttribute demo.ecore#//LearningPath/name"/>
    </genClasses>
    <genClasses ecoreClass="demo.ecore#//LearningObjective">
      <genFeatures createChild="false" ecoreFeature="ecore:EAttribute demo.ecore#//LearningObjective/description"/>
    </genClasses>
    <genClasses ecoreClass="demo.ecore#//GeneratedParameters">
      <genFeatures notify="false" createChild="false" propertySortChoices="true" ecoreFeature="ecore:EReference demo.ecore#//GeneratedParameters/learningobjective"/>
    </genClasses>
  </genPackages>
</genmodel:GenModel>
